---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import siteData from '../../data/site.json';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog" description={`Blog — ${siteData.name}`}>
  <main class="min-h-screen flex flex-col">
    <div class="max-w-2xl mx-auto px-4 py-16 flex-1">
      <h1 class="text-3xl font-medium mb-6">Blog</h1>
      {sorted.length === 0 ? (
        <p class="text-lg leading-relaxed text-zinc-300">
          Coming soon.
        </p>
      ) : (
        <ul class="space-y-4">
          {sorted.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}`}
                class="font-mono text-[#F2511A] hover:text-[#ff6b3d] underline underline-offset-2"
              >
                {post.data.title}
              </a>
              <span class="text-zinc-500 text-sm ml-2">
                {post.data.pubDate.toLocaleDateString()}
              </span>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-8">
        <a href="/" class="font-mono text-[#F2511A] hover:text-[#ff6b3d] underline underline-offset-2">
          &lt;/home&gt;
        </a>
      </p>
    </div>
    <Footer />
  </main>
</Layout>
